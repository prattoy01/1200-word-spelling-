rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection health check endpoint used on boot
    match /test/connection {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Validation Blueprint for Recording
    function isValidRecording(data) {
      return data.keys().hasAll([
          'wordId',
          'word',
          'banglaMeaning',
          'audioDataUrl',
          'mimeType',
          'fileName',
          'fileSize',
          'durationMs',
          'ownerId',
          'ownerName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'wordId',
          'word',
          'banglaMeaning',
          'audioDataUrl',
          'mimeType',
          'fileName',
          'fileSize',
          'durationMs',
          'ownerId',
          'ownerName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.wordId is string && data.wordId.size() >= 1 && data.wordId.size() <= 128 && data.wordId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 120
        && data.banglaMeaning is string && data.banglaMeaning.size() >= 0 && data.banglaMeaning.size() <= 200
        && data.audioDataUrl is string && data.audioDataUrl.size() >= 20 && data.audioDataUrl.size() <= 900000
        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 64
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
        && data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 10485760
        && data.durationMs is number && data.durationMs >= 0 && data.durationMs <= 120000
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120
        && data.status is string && data.status.size() <= 20 && (data.status == 'published' || data.status == 'archived')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint for PracticeSession
    function isValidPracticeSession(data) {
      return data.keys().hasAll([
          'ownerId',
          'category',
          'totalWords',
          'correctCount',
          'accuracy',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'category',
          'totalWords',
          'correctCount',
          'accuracy',
          'results',
          'createdAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 200
        && data.totalWords is number && data.totalWords >= 1 && data.totalWords <= 1000
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= data.totalWords
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && (!('results' in data) || (data.results is list && data.results.size() <= 500 && (data.results.size() == 0 || data.results[0] is map)))
        && data.createdAt is timestamp;
    }

    // Validation Blueprint for AudioContribution
    function isValidAudioContribution(data) {
      return data.keys().hasAll([
          'wordId',
          'word',
          'banglaMeaning',
          'audioDataUrl',
          'mimeType',
          'fileName',
          'fileSize',
          'durationMs',
          'contributorId',
          'contributorName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'wordId',
          'word',
          'banglaMeaning',
          'audioDataUrl',
          'mimeType',
          'fileName',
          'fileSize',
          'durationMs',
          'contributorId',
          'contributorName',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.wordId is string && data.wordId.size() >= 1 && data.wordId.size() <= 128 && data.wordId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 120
        && data.banglaMeaning is string && data.banglaMeaning.size() >= 0 && data.banglaMeaning.size() <= 200
        && data.audioDataUrl is string && data.audioDataUrl.size() >= 20 && data.audioDataUrl.size() <= 900000
        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 64
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
        && data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 10485760
        && data.durationMs is number && data.durationMs >= 0 && data.durationMs <= 120000
        && data.contributorId is string && data.contributorId.size() >= 1 && data.contributorId.size() <= 128 && data.contributorId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.contributorName is string && data.contributorName.size() >= 1 && data.contributorName.size() <= 120
        && data.status is string && data.status.size() <= 20 && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint for UserAccount
    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'passwordHash',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'passwordHash',
          'role',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.passwordHash is string && data.passwordHash.size() >= 32 && data.passwordHash.size() <= 128
        && data.role is string && data.role.size() <= 20 && (data.role == 'admin' || data.role == 'user')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /recordings/{recordingId}
    match /recordings/{recordingId} {
      allow get: if isValidId(recordingId) && (
        resource == null ||
        existing().status == 'published'
      );

      allow list: if existing().status == 'published';

      allow create: if isValidId(recordingId)
        && isValidRecording(incoming())
        && incoming().wordId == recordingId
        && incoming().status == 'published'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(recordingId)
        && isValidRecording(incoming())
        && existing().status != 'archived'
        && incoming().wordId == existing().wordId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Replace audio or update Bangla translation across Web or Mobile App
          (
            incoming().status == 'published'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'word',
              'banglaMeaning',
              'audioDataUrl',
              'mimeType',
              'fileName',
              'fileSize',
              'durationMs',
              'ownerId',
              'ownerName',
              'updatedAt'
            ])
          )
          ||
          // Action 2: Archive a recording
          (
            incoming().ownerId == existing().ownerId
            && incoming().status == 'archived'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(recordingId)
        && existing().status == 'published';
    }

    // Collection: /audioContributions/{contributionId}
    match /audioContributions/{contributionId} {
      allow get: if isValidId(contributionId) && (
        resource == null ||
        existing().status in ['pending', 'approved', 'rejected']
      );

      allow list: if existing().status in ['pending', 'approved', 'rejected'];

      allow create: if isValidId(contributionId)
        && isValidAudioContribution(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(contributionId)
        && isValidAudioContribution(incoming())
        && incoming().wordId == existing().wordId
        && incoming().updatedAt == request.time
        && (
          // Action 1: User submits or updates a pending contribution for this word
          (
            incoming().status == 'pending'
          )
          ||
          // Action 2: Admin approves or rejects a contribution
          (
            (incoming().status == 'approved' || incoming().status == 'rejected')
            && incoming().contributorId == existing().contributorId
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'banglaMeaning'])
          )
        );

      allow delete: if isValidId(contributionId)
        && existing().status in ['pending', 'approved', 'rejected'];
    }

    // Collection: /practiceSessions/{sessionId}
    match /practiceSessions/{sessionId} {
      allow get: if isValidId(sessionId)
        && (resource == null || existing().ownerId.size() >= 1);

      allow list: if existing().ownerId.size() >= 1;

      allow create: if isValidId(sessionId)
        && isValidPracticeSession(incoming())
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isValidId(sessionId)
        && existing().status == 'published';
    }

    // Collection: /userAccounts/{accountId}
    match /userAccounts/{accountId} {
      allow get: if isValidId(accountId) && (
        resource == null ||
        existing().uid == accountId
      );

      allow list: if false;

      allow create: if isValidId(accountId)
        && isValidUserAccount(incoming())
        && incoming().uid == accountId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(accountId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'passwordHash', 'updatedAt']);

      allow delete: if false;
    }

    // Validation Blueprint for PersonalWord
    function isValidPersonalWord(data) {
      return data.keys().hasAll([
          'wordId',
          'word',
          'bangla',
          'example',
          'ownerId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'wordId',
          'word',
          'bangla',
          'example',
          'ownerId',
          'createdAt',
          'updatedAt'
        ])
        && data.wordId is string && data.wordId.size() >= 1 && data.wordId.size() <= 128 && data.wordId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 120
        && data.bangla is string && data.bangla.size() >= 0 && data.bangla.size() <= 200
        && data.example is string && data.example.size() >= 0 && data.example.size() <= 300
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /personalWords/{personalWordId}
    match /personalWords/{personalWordId} {
      allow get: if isValidId(personalWordId) && (
        resource == null ||
        existing().ownerId.size() >= 1
      );

      allow list: if existing().ownerId.size() >= 1;

      allow create: if isValidId(personalWordId)
        && isValidPersonalWord(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(personalWordId)
        && isValidPersonalWord(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().wordId == existing().wordId
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(personalWordId)
        && existing().ownerId.size() >= 1;
    }

    // Validation Blueprint for Contest
    function isValidContest(data) {
      return data.keys().hasAll([
          'id',
          'title',
          'creatorId',
          'creatorName',
          'pageFilter',
          'categories',
          'wordCount',
          'baseSeconds',
          'showBangla',
          'startTimeMs',
          'durationMinutes',
          'randomSeed',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'title',
          'creatorId',
          'creatorName',
          'pageFilter',
          'categories',
          'wordCount',
          'baseSeconds',
          'showBangla',
          'startTimeMs',
          'durationMinutes',
          'randomSeed',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 && data.creatorId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 120
        && data.pageFilter is string && data.pageFilter.size() <= 20 && (data.pageFilter == 'page1' || data.pageFilter == 'page2' || data.pageFilter == 'all')
        && data.categories is list && data.categories.size() <= 50 && (data.categories.size() == 0 || (data.categories[0] is string && data.categories[0].size() <= 100))
        && data.wordCount is number && data.wordCount >= 1 && data.wordCount <= 200
        && data.baseSeconds is number && data.baseSeconds >= 5 && data.baseSeconds <= 60
        && data.showBangla is bool
        && data.startTimeMs is number && data.startTimeMs >= 1700000000000 && data.startTimeMs <= 4102444800000
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 1440
        && data.randomSeed is string && data.randomSeed.size() >= 8 && data.randomSeed.size() <= 128
        && data.status is string && data.status.size() <= 20 && (data.status == 'active' || data.status == 'cancelled')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /contests/{contestId}
    match /contests/{contestId} {
      allow get: if isValidId(contestId) && (
        resource == null ||
        existing().status in ['active', 'cancelled']
      );

      allow list: if existing().status in ['active', 'cancelled'];

      allow create: if isValidId(contestId)
        && isValidContest(incoming())
        && incoming().id == contestId
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(contestId)
        && isValidContest(incoming())
        && incoming().id == existing().id
        && incoming().creatorId == existing().creatorId
        && incoming().randomSeed == existing().randomSeed
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'createdAt', 'updatedAt']);

      allow delete: if isValidId(contestId)
        && existing().status in ['active', 'cancelled'];
    }

    // Validation Blueprint for ContestSubmission
    function isValidContestSubmission(data) {
      return data.keys().hasAll([
          'id',
          'contestId',
          'userId',
          'userName',
          'userEmail',
          'status',
          'totalWords',
          'correctCount',
          'accuracy',
          'timeTakenMs',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'contestId',
          'userId',
          'userName',
          'userEmail',
          'status',
          'totalWords',
          'correctCount',
          'accuracy',
          'timeTakenMs',
          'results',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.contestId is string && data.contestId.size() >= 1 && data.contestId.size() <= 128 && data.contestId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120
        && data.userEmail is string && data.userEmail.size() >= 0 && data.userEmail.size() <= 160
        && data.status is string && data.status.size() <= 20 && (data.status == 'registered' || data.status == 'in_progress' || data.status == 'completed')
        && data.totalWords is number && data.totalWords >= 1 && data.totalWords <= 200
        && data.correctCount is number && data.correctCount >= 0 && data.correctCount <= data.totalWords
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.timeTakenMs is number && data.timeTakenMs >= 0 && data.timeTakenMs <= 7200000
        && (!('results' in data) || (data.results is list && data.results.size() <= 200 && (data.results.size() == 0 || data.results[0] is map)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /contestSubmissions/{submissionId}
    match /contestSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && (
        resource == null ||
        existing().status in ['registered', 'in_progress', 'completed']
      );

      allow list: if existing().status in ['registered', 'in_progress', 'completed'];

      allow create: if isValidId(submissionId)
        && isValidContestSubmission(incoming())
        && incoming().id == submissionId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(submissionId)
        && isValidContestSubmission(incoming())
        && (existing().status != 'in_progress' || incoming().status in ['in_progress', 'completed'])
        && (existing().status != 'completed' || incoming().status == 'completed')
        && incoming().id == existing().id
        && incoming().contestId == existing().contestId
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }
  }
}
