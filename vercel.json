{
  "rewrites": [
    {
      "source": "/api/sync/(.*)",
      "destination": "/api/sync.js"
    },
    {
      "source": "/api/sync",
      "destination": "/api/sync.js"
    },
    {
      "source": "/((?!api/|assets/|dict-fallback/|audio-|manifest\\.webmanifest|sw\\.js|workbox-).*)",
      "destination": "/index.html"
    }
  ]
}
